# Copy file này thành ".env" rồi điền key thật vào, KHÔNG commit .env lên git.

# Dùng để sinh ảnh từ prompt của người chơi (OpenAI Images API - gpt-image-1)
OPENAI_API_KEY=

# Dùng để AI chấm điểm (so sánh ảnh reference với ảnh đội gửi)
ANTHROPIC_API_KEY=

# Cổng chạy server (tùy chọn, mặc định 3000)
PORT=3000
